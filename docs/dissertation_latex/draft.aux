\@writefile{lof}{\contentsline {figure}{\numberline {4.8}{\ignorespaces 3D time per solve at a fixed 20.35M unknowns, one to 32 nodes. Flat MPI and $64\times 2$ reach a minimum and then get slower, while the two most-threaded layouts continue to improve.}}{23}{figure.4.8}\protected@file@percent }
\newlabel{fig:3d-strong20m}{{4.8}{23}{3D time per solve at a fixed 20.35M unknowns, one to 32 nodes. Flat MPI and $64\times 2$ reach a minimum and then get slower, while the two most-threaded layouts continue to improve}{figure.4.8}{}}
\newlabel{fig:3d-strong20m@cref}{{[figure][8][4]4.8}{[1][22][]23}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.9}{\ignorespaces 3D parallel efficiency at a fixed 20.35M unknowns, each layout against its own one-node time. Because the baselines differ, this figure ranks scaling behaviour and not speed; flat MPI falls to 10.9\% at 32 nodes while $16\times 8$ retains 44.5\%.}}{23}{figure.4.9}\protected@file@percent }
\newlabel{fig:3d-strong20m-eff}{{4.9}{23}{3D parallel efficiency at a fixed 20.35M unknowns, each layout against its own one-node time. Because the baselines differ, this figure ranks scaling behaviour and not speed; flat MPI falls to 10.9\% at 32 nodes while $16\times 8$ retains 44.5\%}{figure.4.9}{}}
